generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

// Atualizamos os status para o fluxo da oficina
enum Status {
  ABERTURA_DIAGNOSTICO
  APROVACAO_ORCAMENTO
  EXECUCAO_TRABALHO
  ENTREGA_CARRO
}

model OrdemServico {
  id                  String     @id @default(uuid())
  cliente             String
  veiculo             String
  problemaRelatado    String
  diagnosticoMecanico String?
  itensOrcamento      Json?

  prioridade          Prioridade @default(BAIXA)
  status              Status     @default(ABERTURA_DIAGNOSTICO)

  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime?  @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  // Relação com a trilha de auditoria
  historico           HistoricoOS[]

  @@map("ordens_servico")
}

// Tabela obrigatória para a avaliação (Rastreabilidade e Trilha de Auditoria)
model HistoricoOS {
  id              String       @id @default(uuid())
  id_registro     String
  estado_anterior Status
  novo_estado     Status
  autor_id        String       // ID do mecânico ou rececionista
  justificativa   String?
  timestamp       DateTime     @default(now())

  ordemServico    OrdemServico @relation(fields: [id_registro], references: [id])

  @@map("historico_os")
}
model PecaEstoque {
  id         String   @id @default(uuid())
  nome       String
  quantidade Int      @default(0)
  preco      Float

  @@map("pecas_estoque")
}

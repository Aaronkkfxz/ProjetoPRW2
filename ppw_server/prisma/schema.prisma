generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["bi304128x"]
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA

  @@schema("bi304128x")
}

enum Status {
  ABERTURA_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  AGUARDANDO_PECAS
  EXECUCAO_TRABALHO
  CONCLUIDO
  ENTREGUE

  @@schema("bi304128x")
}

model OrdemServico {
  id                  String     @id @default(uuid())
  cliente             String
  veiculo             String
  problemaRelatado    String
  diagnosticoMecanico String?
  itensOrcamento      Json?

  prioridade          Prioridade @default(BAIXA)
  status              Status     @default(ABERTURA_DIAGNOSTICO)

  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime?  @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  historico           HistoricoOS[]

  @@map("ordens_servico")
  @@schema("bi304128x")
}

model HistoricoOS {
  id              String       @id @default(uuid())
  id_registro     String
  estado_anterior Status
  novo_estado     Status
  autor_id        String
  justificativa   String?
  timestamp       DateTime     @default(now())

  ordemServico    OrdemServico @relation(fields: [id_registro], references: [id])

  @@map("historico_os")
  @@schema("bi304128x")
}

model PecaEstoque {
  id         String   @id @default(uuid())
  nome       String
  quantidade Int      @default(0)
  preco      Float

  @@map("pecas_estoque")
  @@schema("bi304128x")
}
